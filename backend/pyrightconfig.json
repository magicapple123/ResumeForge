  "include": [
    "app"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  // 本地开发用 backend/.venv；CI 里全局装包时 pyright 会回退到当前解释器的
  // site-packages（缺失导入只是 warning，不挡门禁——门禁目标是这些层的类型错误）。
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none",
  "exclude": [
    "**/__pycache__"
  ]
}
