{
  // 渐进类型检查（工程师评审 P1-4）：先钉住类型边界最清晰的两层。
  // 新增代码按 basic 通过；其余子目录在存量类型注解补齐后逐个加进 include。
  // RF-21 评估（2026-10-11）：app/runtime 试跑 0 错误，直接纳入；services/llm
  // 3 错、services/assistant_tools 32 错（集中在 reportArgumentType 的 None 收窄），
  // 扩面需先修存量，见 deliverables 的 RF-21 交付报告。
  // PR-18 扩面（2026-10-13）：逐一探测 services/ 各子包——data_backup/drill/
  // job_parser/interview/assistant 均 0 错、apply 8、browser 17、api/ 65。选
  // data_backup（备份/恢复是关键路径，PR-15 刚触及资产清单与命名空间）纳入；
  // 其余 0 错子包待后续批次逐个纳入。
  // 第二批扩面（2026-10-13）：apply（8 错：str→Literal 状态收窄、job_id None 守卫、
  // CdpClient 基类补 navigate/set_file_input）与 browser（17 错：WindowAwareMixin
  // 宿主契约 Protocol 化、可选成员 None 收窄）修完后纳入，两目录均 0 错。
  "include": [
    "app/models",
    "app/schemas",
    "app/runtime",
    "app/services/data_backup",
    "app/services/apply",
    "app/services/browser"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.11",
  // 本地开发用 backend/.venv；CI 里全局装包时 pyright 会回退到当前解释器的
  // site-packages（缺失导入只是 warning，不挡门禁——门禁目标是这两层的类型错误）。
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none",
  "exclude": [
    "**/__pycache__"
  ]
}
