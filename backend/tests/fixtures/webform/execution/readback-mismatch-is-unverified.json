  "profile": {"name": "张三"},
  "script": [
    {"needle": "rf:set-value", "reply": "{\"ok\": true, \"value\": \"张三\"}"},
    {"needle": "rf:read-back", "reply": "{\"ok\": true, \"value\": \"李四\", \"checked\": false}"},
    {"needle": "rf:read-back", "reply": "{\"ok\": true, \"value\": \"李四\", \"checked\": false}"},
    {"needle": "rf:read-back", "reply": "{\"ok\": true, \"value\": \"李四\", \"checked\": false}"}
  ],
  "expect": {
    "outcomes": [
      {
        "field": "name",
        "status": "unverified",
        "note_contains": "与期望不符",
        "reason": "value_mismatch",
