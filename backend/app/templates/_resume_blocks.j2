{# 简历正文的七个分区，每个一个宏。
   拆出来的唯一目的是让 `_resume_sections.j2` 能**按用户设定的顺序**渲染它们：
   在宏里渲染的分区换位置只需要换调用顺序，不必复制一份标记。

   标记本身是从原来那份顺序写死的模板里**原样搬过来的**，一个属性都没改
   （`data-resume-path` 供前端「点击纸面字段定位编辑」使用，改了它预览就点不动了）。
   分区顺序的定义与归一化见 `services/resume/resume_sections.py`。 #}

{% macro summary_block(resume) %}
{% if resume.summary %}
<div class="section" data-section="summary">
  <div class="section-title" data-role="section_title">{{ section_titles.summary }}</div>
  <p class="summary-text" data-resume-path="summary" data-role="body">{{ resume.summary }}</p>
</div>
{% endif %}
{% endmacro %}

{% macro education_block(resume) %}
{% if resume.education %}
<div class="section" data-section="education">
  <div class="section-title" data-role="section_title">{{ section_titles.education }}</div>
  {% for edu in resume.education %}
  {% set edu_index = loop.index0 %}
  <div class="entry"{% if edu.id %} data-object-id="{{ edu.id }}"{% endif %}>
    <div class="entry-head">
      <span class="title" data-role="entry_title"><span data-resume-path="education.{{ edu_index }}.school">{{ edu.school }}</span>{% if edu.major %} · <span data-resume-path="education.{{ edu_index }}.major">{{ edu.major }}</span>{% endif %}</span>
      <span class="meta" data-role="meta">{% if edu.degree %}<span data-resume-path="education.{{ edu_index }}.degree">{{ edu.degree }}</span> · {% endif %}<span data-resume-path="education.{{ edu_index }}.start_date">{{ edu.start_date }}</span> - <span data-resume-path="education.{{ edu_index }}.end_date">{{ edu.end_date }}</span></span>
    </div>
    {% if edu.gpa %}<div class="sub" data-role="meta">{{ field_labels.gpa }}：<span data-resume-path="education.{{ edu_index }}.gpa">{{ edu.gpa }}</span></div>{% endif %}
    {% if edu.courses %}<div class="sub" data-role="meta">{{ field_labels.courses }}：{% for item in edu.courses %}<span data-resume-path="education.{{ edu_index }}.courses.{{ loop.index0 }}">{{ item }}</span>{% if not loop.last %}{{ list_separator }}{% endif %}{% endfor %}</div>{% endif %}
    {% if edu.achievements %}<ul>{% for item in edu.achievements %}<li data-role="body" data-resume-path="education.{{ edu_index }}.achievements.{{ loop.index0 }}">{{ item }}</li>{% endfor %}</ul>{% endif %}{% if edu.study_form %}<div class="sub" data-role="meta">{{ field_labels.study_form }}：<span data-resume-path="education.{{ edu_index }}.study_form">{{ edu.study_form }}</span></div>{% endif %}
    {% if edu.degree_type %}<div class="sub" data-role="meta">{{ field_labels.degree_type }}：<span data-resume-path="education.{{ edu_index }}.degree_type">{{ edu.degree_type }}</span></div>{% endif %}
    {% if edu.department %}<div class="sub" data-role="meta">{{ field_labels.department }}：<span data-resume-path="education.{{ edu_index }}.department">{{ edu.department }}</span></div>{% endif %}
    {% if edu.rank %}<div class="sub" data-role="meta">{{ field_labels.rank }}：<span data-resume-path="education.{{ edu_index }}.rank">{{ edu.rank }}</span></div>{% endif %}
    {% if edu.advisor %}<div class="sub" data-role="meta">{{ field_labels.advisor }}：<span data-resume-path="education.{{ edu_index }}.advisor">{{ edu.advisor }}</span></div>{% endif %}
    {% if edu.research_direction %}<div class="sub" data-role="meta">{{ field_labels.research_direction }}：<span data-resume-path="education.{{ edu_index }}.research_direction">{{ edu.research_direction }}</span></div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro experience_block(resume) %}
{% if resume.experience %}
<div class="section" data-section="experience">
  <div class="section-title" data-role="section_title">{{ section_titles.experience }}</div>
