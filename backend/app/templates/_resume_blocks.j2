  <div class="entry"{% if exp.id %} data-object-id="{{ exp.id }}"{% endif %}>
    <div class="entry-head">
      <span class="title" data-role="entry_title"><span data-resume-path="experience.{{ exp_index }}.company">{{ exp.company }}</span>{% if exp.role %} · <span data-resume-path="experience.{{ exp_index }}.role">{{ exp.role }}</span>{% endif %}</span>
      <span class="meta" data-role="meta"><span data-resume-path="experience.{{ exp_index }}.start_date">{{ exp.start_date }}</span> - <span data-resume-path="experience.{{ exp_index }}.end_date">{{ exp.end_date }}</span></span>
    </div>
    {% if exp.experience_kind %}<div class="sub" data-role="meta">{{ field_labels.experience_kind }}：<span data-resume-path="experience.{{ exp_index }}.experience_kind">{{ experience_kind_text(exp.experience_kind) }}</span></div>{% endif %}
    {% if exp.description %}<ul>{% for item in exp.description %}<li data-role="body" data-resume-path="experience.{{ exp_index }}.description.{{ loop.index0 }}">{{ item }}</li>{% endfor %}</ul>{% endif %}{% if exp.team_size %}<div class="sub" data-role="meta">{{ field_labels.team_size }}：<span data-resume-path="experience.{{ exp_index }}.team_size">{{ exp.team_size }}</span></div>{% endif %}
