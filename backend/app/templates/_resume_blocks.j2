  <ul class="skill-list">
    {% for skill in resume.skills %}<li data-role="body"{% if skill.id %} data-object-id="{{ skill.id }}"{% endif %}><span data-resume-path="skills.{{ loop.index0 }}.name">{{ skill.name }}</span>{% if skill.level %}{{ level_parens[0] }}<span data-resume-path="skills.{{ loop.index0 }}.level">{{ skill.level }}</span>{{ level_parens[1] }}{% endif %}{% if skill.category %} · <span class="sub" data-role="meta" data-resume-path="skills.{{ loop.index0 }}.category">{{ field_labels.category }}：{{ skill.category }}</span>{% endif %}</li>{% endfor %}
  </ul>
</div>
{% endif %}
{% endmacro %}

{% macro languages_block(resume) %}
{% if resume.languages %}
<div class="section" data-section="languages">
  <div class="section-title" data-role="section_title">{{ section_titles.languages }}</div>
  <ul class="skill-list">
    {% for language in resume.languages %}<li data-role="body"{% if language.id %} data-object-id="{{ language.id }}"{% endif %}>{% if language.name %}<span data-resume-path="languages.{{ loop.index0 }}.name">{{ language.name }}</span>{% endif %}{% if language.level or language.certificate or language.score %}{{ level_parens[0] }}{% if language.level %}<span data-resume-path="languages.{{ loop.index0 }}.level">{{ language.level }}</span>{% endif %}{% if language.certificate %}{% if language.level %} · {% endif %}<span data-resume-path="languages.{{ loop.index0 }}.certificate">{{ language.certificate }}</span>{% endif %}{% if language.score %}{% if language.level or language.certificate %} · {% endif %}<span data-resume-path="languages.{{ loop.index0 }}.score">{{ language.score }}</span>{% endif %}{{ level_parens[1] }}{% endif %}{% if language.obtained_at %}<span class="sub" data-role="meta"> · {{ field_labels.obtained }}：<span data-resume-path="languages.{{ loop.index0 }}.obtained_at">{{ language.obtained_at }}</span></span>{% endif %}</li>{% endfor %}
  </ul>
</div>
{% endif %}
{% endmacro %}

{% macro awards_block(resume) %}
{% if resume.awards %}
<div class="section" data-section="awards">
  <div class="section-title" data-role="section_title">{{ section_titles.awards }}</div>
  <ul>
    {% for award in resume.awards %}
    <li data-role="body"{% if award.id %} data-object-id="{{ award.id }}"{% endif %}><span data-resume-path="awards.{{ loop.index0 }}.name">{{ award.name }}</span>{% if award.date %} · <span data-resume-path="awards.{{ loop.index0 }}.date">{{ award.date }}</span>{% endif %}{% if award.description %} · <span data-resume-path="awards.{{ loop.index0 }}.description">{{ award.description }}</span>{% endif %}{% if award.issuer %}<div class="sub" data-role="meta">{{ field_labels.issuer }}：<span data-resume-path="awards.{{ loop.index0 }}.issuer">{{ award.issuer }}</span></div>{% endif %}{% if award.level %}<div class="sub" data-role="meta">{{ field_labels.level }}：<span data-resume-path="awards.{{ loop.index0 }}.level">{{ award.level }}</span></div>{% endif %}{% if award.ratio %}<div class="sub" data-role="meta">{{ field_labels.ratio }}：<span data-resume-path="awards.{{ loop.index0 }}.ratio">{{ award.ratio }}</span></div>{% endif %}</li>
    {% endfor %}
