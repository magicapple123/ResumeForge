{% macro publications_block(resume) %}
{% if resume.publications %}
<div class="section" data-section="publications">
  <div class="section-title" data-role="section_title">{{ section_titles.publications }}</div>
  {% for publication in resume.publications %}
  {% set pub_index = loop.index0 %}
  <div class="entry"{% if publication.id %} data-object-id="{{ publication.id }}"{% endif %}>
    <div class="entry-head">
      <span class="title" data-role="entry_title" data-resume-path="publications.{{ pub_index }}.title">{{ publication.title }}</span>
      <span class="meta" data-role="meta">{% if publication.venue %}{{ publication.venue }}{% endif %}{% if publication.year %} · {{ publication.year }}{% endif %}{% if publication.status != "other" %} · {{ publication_status_text(publication.status) }}{% endif %}</span>
    </div>
    {% if publication.authors %}
    <div class="sub" data-role="meta">{% for author in publication.authors %}<span data-resume-path="publications.{{ pub_index }}.authors.{{ loop.index0 }}.name">{% if author.is_self %}<strong>{{ author.name }}</strong>{% else %}{{ author.name }}{% endif %}{% if author.corresponding %}*{% endif %}</span>{% if not loop.last %}{{ list_separator }}{% endif %}{% endfor %}</div>
    {% endif %}
    {% if publication.volume_pages or publication.doi or publication.url or publication.note %}
    {% set publication_extra = publication_detail(publication) %}{% if publication_extra %}<div class="sub" data-role="meta">{{ publication_extra }}</div>{% endif %}
    {% endif %}{% if publication.outcome_type %}<div class="sub" data-role="meta">{{ field_labels.outcome_type }}：<span data-resume-path="publications.{{ pub_index }}.outcome_type">{{ publication.outcome_type }}</span></div>{% endif %}{% if publication.my_rank %}<div class="sub" data-role="meta">{{ field_labels.my_rank }}：<span data-resume-path="publications.{{ pub_index }}.my_rank">{{ publication.my_rank }}</span></div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

