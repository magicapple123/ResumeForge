{% macro credentials_block(resume) %}
{% if resume.credentials %}
<div class="section" data-section="credentials">
  <div class="section-title" data-role="section_title">{{ section_titles.credentials }}</div>
  {% for credential in resume.credentials %}
  {% set credential_index = loop.index0 %}
