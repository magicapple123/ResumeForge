{% macro projects_block(resume) %}
{% if resume.projects %}
<div class="section" data-section="projects">
  <div class="section-title" data-role="section_title">{{ section_titles.projects }}</div>
  {% for project in resume.projects %}
  {% set project_index = loop.index0 %}
  <div class="entry"{% if project.id %} data-object-id="{{ project.id }}"{% endif %}>
    <div class="entry-head">
      <span class="title" data-role="entry_title" data-resume-path="projects.{{ project_index }}.name">{{ project.name }}</span>
      <span class="meta" data-role="meta">{% if project.role %}<span data-resume-path="projects.{{ project_index }}.role">{{ project.role }}</span> · {% endif %}<span data-resume-path="projects.{{ project_index }}.start_date">{{ project.start_date }}</span> - <span data-resume-path="projects.{{ project_index }}.end_date">{{ project.end_date }}</span></span>
    </div>
    {% if project.tech_stack %}<div class="sub" data-role="meta">{{ field_labels.tech_stack }}：{% for item in project.tech_stack %}<span data-resume-path="projects.{{ project_index }}.tech_stack.{{ loop.index0 }}">{{ item }}</span>{% if not loop.last %}{{ list_separator }}{% endif %}{% endfor %}</div>{% endif %}
    {% if project.artifact_type or project.public_url %}<div class="sub" data-role="meta">{% if project.artifact_type %}{{ field_labels.artifact_type }}：<span data-resume-path="projects.{{ project_index }}.artifact_type">{{ project.artifact_type }}</span>{% endif %}{% if project.artifact_type and project.public_url %} · {% endif %}{% if project.public_url %}<span data-resume-path="projects.{{ project_index }}.public_url">{{ project.public_url }}</span>{% endif %}</div>{% endif %}
    {% if project.description %}<ul>{% for item in project.description %}<li data-role="body" data-resume-path="projects.{{ project_index }}.description.{{ loop.index0 }}">{{ item }}</li>{% endfor %}</ul>{% endif %}
    {% if project.highlights %}<ul>{% for item in project.highlights %}<li data-role="body" data-resume-path="projects.{{ project_index }}.highlights.{{ loop.index0 }}">{{ item }}</li>{% endfor %}</ul>{% endif %}{% if project.project_size %}<div class="sub" data-role="meta">{{ field_labels.project_size }}：<span data-resume-path="projects.{{ project_index }}.project_size">{{ project.project_size }}</span></div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro skills_block(resume) %}
