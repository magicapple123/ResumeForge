{# C2/R-79 自建大字段：独立成一栏，与 13 个系统分区同级，排在它们之后（资料页全局顺序，
   由投影层冻结，渲染端不再排序）。条目 = 主文本 + 其余非空字段的「标签：值」行。
   空列表时整个宏输出**零字节**——没有自建分区的旧简历纸面逐字节不变（黄金矩阵守着）。 #}
{% macro custom_sections_block(resume) -%}
{%- for section in resume.custom_sections -%}
{%- set section_index = loop.index0 -%}
{%- set visible = namespace(entries=[]) -%}
{%- for entry in section.entries -%}
{%- set entry_state = namespace(has_line=false) -%}
{%- for line in entry.lines %}{% if line.value|trim %}{% set entry_state.has_line = true %}{% endif %}{% endfor -%}
{%- if entry.text|trim or entry_state.has_line -%}
{%- set visible.entries = visible.entries + [(entry, loop.index0)] -%}
{%- endif -%}
{%- endfor -%}
{%- if visible.entries %}
<div class="section" data-section="{{ section.key }}">
  <div class="section-title" data-role="section_title">{{ section.title }}</div>
  {%- for entry, entry_index in visible.entries %}
  <div class="entry"{% if entry.entry_id %} data-object-id="{{ entry.entry_id }}"{% endif %}>
    {% if entry.text|trim %}<p data-role="body" data-resume-path="custom_sections.{{ section_index }}.entries.{{ entry_index }}.text">{{ entry.text }}</p>{% endif %}
    {% for line in entry.lines %}{% if line.value|trim %}<div class="sub" data-role="meta">{{ line.label }}：<span data-resume-path="custom_sections.{{ section_index }}.entries.{{ entry_index }}.lines.{{ loop.index0 }}.value">{{ line.value }}</span></div>{% endif %}{% endfor %}
  </div>
  {%- endfor %}
</div>
{%- endif -%}
{%- endfor -%}
{%- endmacro %}
