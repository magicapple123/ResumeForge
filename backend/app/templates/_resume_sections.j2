{# 简历正文的共享片段：内置模板只在样式上不同，结构完全一致。
   每处文本都带 data-resume-path，供前端「点击纸面字段定位编辑」使用。

   分区顺序由 `resume_section_order` 决定（见 services/resume/resume_sections.py）：
   它永远是七个键的一个完整排列，渲染器不必处理"某个键不在列表里"的情况。
   页眉（姓名 / 求职意向 / 联系方式 / 照片）不参与排序，固定在最前。

   默认顺序与重排前的写死顺序完全一致，所以没有动过顺序的简历，输出与以前一字不差。 #}
{% import "_resume_blocks.j2" as blocks with context %}
<div class="header">
  <div class="header-main">
    <div class="name" data-role="name"><span data-resume-path="name">{{ resume.name }}</span>{% if resume.gender %} <span data-resume-path="gender" class="name-extra" data-role="meta">{{ resume.gender }}</span>{% endif %}</div>
    {% if resume.job_intent %}<div class="intent" data-role="meta">{{ field_labels.intent }}：<span data-resume-path="job_intent">{{ resume.job_intent }}</span></div>{% endif %}
  {# 联系方式（#3）：字段顺序 / 文案 / 强制换行来自 `resume_contact.contact_items`，
     四个渲染器（HTML / PDF / Word / 草稿预览）共用同一份，这里只负责把
     break_before 译成标记：<br> = 用户设置的强制换行；<wbr> = 字段之间的自动换行点。
     <span> 之间没有空白字符，浏览器本来**没有**换行点——不加 <wbr> 时整行只能
     从字段内部劈开（"个人主页：huangcenguo.top" 被截成两行的根因）。
     字段内部的 nowrap 在各模板 `.header .contact span` 上声明；缺了它 <wbr> 会
     退化成"可在字段内任意折行"的旧行为。 #}
  <div class="contact" data-role="meta">
      {%- for item in contact_items -%}
      {%- if item.break_before %}<br />{% elif not loop.first %}<wbr />{% endif -%}
      <span data-resume-path="{{ item.key }}">{{ item.text }}</span>
      {%- endfor -%}
    </div>
    {% if template_config.badges %}
    <div class="template-badges" aria-label="模板装饰">
      {% for badge in template_config.badges %}
      <span class="template-badge">
        {% if badge.image %}<img src="{{ badge.image }}" alt="{{ badge.alt }}" />{% endif %}
        {% if badge.label %}<span>{{ badge.label }}</span>{% endif %}
      </span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% if resume.photo %}<img class="profile-photo" src="{{ resume.photo }}" alt="{{ field_labels.photo_alt }}" />{% endif %}
</div>

{% set use_section_grid = template_config.column_count|default(1) == 2 %}
{% if use_section_grid %}<div class="resume-sections" data-columns="2">{% endif %}
{% for section_key in resume_section_order -%}
{%- if section_key == "summary" %}{{ blocks.summary_block(resume) }}
{%- elif section_key == "education" %}{{ blocks.education_block(resume) }}
{%- elif section_key == "experience" %}{{ blocks.experience_block(resume) }}
{%- elif section_key == "campus_experience" %}{{ blocks.campus_block(resume) }}
{%- elif section_key == "projects" %}{{ blocks.projects_block(resume) }}
{%- elif section_key == "publications" %}{{ blocks.publications_block(resume) }}
{%- elif section_key == "research_projects" %}{{ blocks.research_projects_block(resume) }}
{%- elif section_key == "patents" %}{{ blocks.patents_block(resume) }}
{%- elif section_key == "credentials" %}{{ blocks.credentials_block(resume) }}
{%- elif section_key == "skills" %}{{ blocks.skills_block(resume) }}
{%- elif section_key == "languages" %}{{ blocks.languages_block(resume) }}
{%- elif section_key == "awards" %}{{ blocks.awards_block(resume) }}
{%- endif %}
{% endfor -%}
{% if use_section_grid %}</div>{% endif %}{{ blocks.custom_sections_block(resume) }}
