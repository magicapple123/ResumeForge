<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'nonce-{{ csp_nonce }}'; base-uri 'none'; form-action 'none'" />
<title>{{ resume.name }} - {{ resume.job_intent }} - 简历</title>
<style>
  /* 社论：衬线字体、居中标题与细线分隔，适合文商科、内容与管理岗位。 */
  :root {
    --text: #2f2a28;
    --muted: #81746e;
    --line: #e5d8d3;
    --accent: #8b3a3a;
    --bg: #fffdfb;
    --fs: calc({{ base_px }}px * var(--fit-scale, 1));
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: Georgia, "Noto Serif CJK SC", serif;
    color: var(--text);
    background: var(--bg);
    font-size: var(--fs);
    line-height: 1.75;
    width: 210mm;
    height: {{ page_limit * 297 }}mm;
    padding: 18mm;
  }
  .header { display: flex; align-items: flex-start; gap: calc(var(--fs) * 1.7); border-bottom: 1px solid var(--accent); padding-bottom: calc(var(--fs) * 1); margin-bottom: calc(var(--fs) * 1.5); }
  .header-main { flex: 1; min-width: 0; text-align: center; }
  .header .name { font-size: calc(var(--fs) * 1.9); font-weight: 700; color: var(--accent); letter-spacing: 1.5px; }
  .name-extra { font-size: calc(var(--fs) * .93); font-weight: 400; color: var(--muted); }
  .header .intent { font-size: var(--fs); color: var(--muted); margin-top: calc(var(--fs) * .28); }
  .header .contact { font-size: calc(var(--fs) * .9); color: var(--muted); margin-top: calc(var(--fs) * .57); }
  .header .contact span { margin-right: calc(var(--fs) * 1.14); }
  .profile-photo { width: calc(var(--fs) * 6.2); height: calc(var(--fs) * 6.2); flex: 0 0 auto; object-fit: cover; border: 1px solid var(--line); border-radius: 50%; }
  .section { margin-bottom: calc(var(--fs) * 1.35); }
  .section-title { font-size: calc(var(--fs) * 1.11); font-weight: 700; color: var(--accent); text-align: center; padding-bottom: calc(var(--fs) * .25); border-bottom: 1px solid var(--line); margin-bottom: calc(var(--fs) * .75); }
  .entry { margin-bottom: calc(var(--fs) * .85); }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--fs); }
  .entry-head .title { font-size: calc(var(--fs) * 1.05); font-weight: 600; }
  .entry-head .meta { font-size: calc(var(--fs) * .9); color: var(--muted); white-space: nowrap; }
  .entry .sub { font-size: calc(var(--fs) * .9); color: var(--muted); margin: calc(var(--fs) * .14) 0 calc(var(--fs) * .28); }
  ul { padding-left: calc(var(--fs) * 1.43); }
  li { margin-bottom: calc(var(--fs) * .2); }
  .summary-text { font-size: var(--fs); }
  .skill-list { padding-left: 0; }
  .skill-list li { list-style: none; display: inline-block; margin: 0 calc(var(--fs) * .57) calc(var(--fs) * .35) 0; font-size: calc(var(--fs) * .93); color: var(--accent); }
  @page { size: A4; margin: 0; }
  @media print { .section, .entry { break-inside: avoid; } * { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>
</head>
<body>
{% include "_resume_sections.j2" %}
{% include "_resume_fit_script.j2" %}
</body>
</html>
