# ===== ResumeForge 后端配置示例 =====
# 复制本文件为 .env 后按需修改；全部配置都有默认值，不配置也能直接运行。

# SQLite 数据库文件路径（默认在 backend/data/ 目录下自动创建）
DATABASE_URL=sqlite:///./data/resume_forge.db

# 允许跨域的前端地址，多个用英文逗号分隔（开发环境默认 Vite 端口 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单个 HTTP 请求体上限（MB）；需容纳最多 2 MB 的简历照片及资料正文
MAX_REQUEST_BODY_MB=8

# 数据恢复上传备份包的上限（MB）。该请求体是流式落盘的，内存占用与包大小无关；
# 其余接口仍受上面的 MAX_REQUEST_BODY_MB 约束。
MAX_BACKUP_UPLOAD_MB=512

# 可选：日志按 JSON 行格式输出（控制台与滚动文件共用，RF-20）。默认关闭，
# 保持人类可读格式；开启后每行为 time/level/logger/message/task_id/
# dataset_id/request_id 等结构化字段，便于机器采集。
LOG_JSON_FORMAT=false

# 简历生成后台任务的总预算（秒）：到期即断流并把任务标为 failed。
# 默认 600；生成特别长的简历时可调大。
RESUME_GENERATE_BUDGET_SECONDS=600

# 自动备份调度线程的检查周期（秒，最小 60）：长期不重启也会到期检查（RF-05）。
AUTO_BACKUP_CHECK_SECONDS=21600

# 求职助手一次回复的整链预算（秒）：覆盖全部工具轮次与模型流式输出，到期即在
# 下一个事件边界收尾为 error。默认 600；长回答经常被截断时可调大。
ASSISTANT_STREAM_BUDGET_SECONDS=600

# 可选：OpenAI 兼容流式请求发送 stream_options.include_usage 以获取 token 用量。
# 该开关会改变默认请求体，默认关闭；关闭时只读取服务商自带的 usage 帧。
LLM_STREAM_INCLUDE_USAGE=false

# 可选：token 估算遥测（默认关）。开启后只在用量遥测里多一个 estimated_* 字段，
# 不改变任何请求内容，也不做按 token 截断。
LLM_TOKEN_ESTIMATE_ENABLED=false

# 可选：前端启动模式（auto / dev / production）。auto（默认）= 发布包带
# frontend/dist 时由后端同源提供页面（运行期不需要 Node），没有 dist 退回
# Vite dev 模式；dev=强制 Vite 开发服务器；production=必须有 dist，缺失直接
# 报错退出。命令行参数（--frontend-mode）优先于本值。
FRONTEND_MODE=auto
