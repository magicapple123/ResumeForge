{
  "name": "resumeforge-frontend",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/magicapple123/ResumeForge.git"
  },
  "bugs": {
    "url": "https://github.com/magicapple123/ResumeForge/issues"
  },
  "homepage": "https://github.com/magicapple123/ResumeForge#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed HEAD",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src vite.config.ts vitest.config.ts eslint.config.js package.json index.html",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts eslint.config.js package.json index.html"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
